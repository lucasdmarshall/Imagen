# SHOW AI service env. Copy to `.env` in this directory.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_ENV=development

# Text models (Prompt Generator).
PROMPT_MODEL_GEMINI_FLASH=google/gemini-3.7-flash
PROMPT_MODEL_GPT_LUNA=openai/gpt-5.6-luna
PROMPT_MODEL_GPT_MINI=openai/gpt-5-mini
PROMPT_MODEL_DEFAULT=google/gemini-3.7-flash

# Image models (Image Generator).
IMAGE_MODEL_NANO_BANANA_PRO=google/gemini-3.1-flash-lite-image
IMAGE_MODEL_GPT_IMAGE=openai/gpt-image-2
