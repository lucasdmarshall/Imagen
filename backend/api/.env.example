# SHOW Go API env. Copy to `.env` in this directory (or export in your shell).
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://show:show_dev_password@localhost:5432/show?sslmode=disable
AI_SERVICE_URL=http://localhost:8000

# DISPOSABLE dev tools: mounts /api/dev/* (development only). Delete after dev.
# Defaults on in development; forced off when APP_ENV != development.
DEV_TOOLS=true
