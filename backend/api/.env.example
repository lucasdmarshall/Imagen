# SHOW Go API env. Copy to `.env` in this directory (or export in your shell).
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://show:show_dev_password@localhost:5432/show?sslmode=disable
AI_SERVICE_URL=http://localhost:8000

# DISPOSABLE dev tools: mounts /api/dev/* (development only). Delete after dev.
# Defaults on in development; forced off when APP_ENV != development.
DEV_TOOLS=true

# ---- Security ----
# CORS allow-list (comma-separated). Flutter Web dev origin(s).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
# Per-IP request cap per minute.
RATE_LIMIT_PER_MIN=120
# Max request body size in bytes (default 1 MiB).
MAX_BODY_BYTES=1048576
