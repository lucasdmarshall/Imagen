# SHOW — shared dev environment template. Copy to `.env` and fill in.
# Never commit the real .env.

# ---- Postgres (dev via docker-compose) ----
POSTGRES_USER=show
POSTGRES_PASSWORD=show_dev_password
POSTGRES_DB=show
# Connection string consumed by the Go API and any tooling.
DATABASE_URL=postgres://show:show_dev_password@localhost:5432/show?sslmode=disable

# ---- Go API ----
PORT=8080
APP_ENV=development
AI_SERVICE_URL=http://localhost:8000

# Bootstrap the first admin (created/promoted at startup; prod has no dev tools).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Published host port for the API container (override on shared servers).
API_HOST_PORT=8080

# ---- Python AI service ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Flutter apps (dev) ----
# Passed with --dart-define=API_BASE_URL=...
API_BASE_URL=http://localhost:8080
